# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ai_task_km

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_secret_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Embedding model (downloaded locally by sentence-transformers, no external API calls at query time)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage
UPLOAD_DIR=storage/uploads
VECTOR_INDEX_DIR=storage/vector_index

# Default admin bootstrap (used by seed script)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123
